# Copy to .env and edit. Every value has a working default in compose.yaml.

# Trustvian source to build the CLI and trustvian-local from: a branch, a tag
# or a commit SHA. Keep it on the same release as the collector image below.
TRUSTVIAN_REF=v0.10.0

# The Collector is not built: it comes from the signed release image, pinned
# by the digest of its multi-arch index (the v0.10.0 tag is informational).
TRUSTVIAN_COLLECTOR_IMAGE=ghcr.io/trustvian/trustvian-collector:v0.10.0@sha256:192b28541fe2441a72d047b3cb72ac93bba0bccf64a140bab4b0673869c9f5ba

# Host port of the WebUI / API (published on 127.0.0.1 only).
TRUSTVIAN_WEB_PORT=8080

# The model, in provider/model form, and where it is served. It must support
# tool calling (`ollama show <model>` lists "tools"); gemma3 does not.
#   Ollama in Compose (default)   ollama/qwen2.5:3b  http://ollama:11434   (pulled by ollama-pull on `up`)
#   Ollama on the host            ollama/qwen2.5:3b  http://host.docker.internal:11434
#                                 (faster on a Mac: Metal. `ollama pull qwen2.5:3b` on the host yourself)
#   vLLM                          hosted_vllm/<served-model-name>  http://<host>:8000/v1
#   OpenAI                        openai/gpt-4o-mini  (set LLM_BASE_URL= to EMPTY, set OPENAI_API_KEY)
# Larger tool-capable Ollama models follow the prompt better: qwen2.5:7b, llama3.1:8b
# (give Docker Desktop >= 8 GB of memory for those).
LLM_MODEL=ollama/qwen2.5:3b
LLM_BASE_URL=http://ollama:11434

# ollama image tag and how long a loaded model stays in memory between runs.
#OLLAMA_TAG=latest
#OLLAMA_KEEP_ALIVE=30m
#OPENAI_API_KEY=

# Identity of what dev provisions on the control plane.
TRUSTVIAN_PROJECT=trustvian-crewai-quickstart
TRUSTVIAN_AGENT=support-crew
